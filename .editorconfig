# EditorConfig — https://editorconfig.org
# Every tracked text file in this repo is actually CRLF (verified against the
# committed blobs, not just assumed) — this mirrors .gitattributes, which
# declares eol=crlf for the same extensions.
root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4

# Markdown: trailing spaces are a significant hard line break.
[*.md]
trim_trailing_whitespace = false

# Binary assets (matches the `binary` entries in .gitattributes).
[*.{ico,exe,png,mo}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
